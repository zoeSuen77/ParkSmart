{
  "name": "parksmart",
  "version": "1.0.0",
  "private": true,
  "description": "ParkSmart: Campus Parking Availability and Management System (Team 5 prototype)",
  "scripts": {
    "dev": "node server/index.js",
    "dev:hot": "concurrently -n server,client -c blue,green \"npm run dev\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "seed": "node server/seed.js",
    "test": "node --test \"server/tests/*.test.js\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "mongodb": "^6.10.0",
    "mongodb-memory-server": "^10.1.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
