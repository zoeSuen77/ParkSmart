# ParkSmart server configuration
# Copy this file to .env (optional). All values have safe local defaults.

# MongoDB connection string. MUST support transactions (replica set or Atlas).
# If unset, the server starts an embedded single-node replica set via
# mongodb-memory-server (first run downloads a mongod binary, ~100 MB).
# MONGODB_URI=mongodb://127.0.0.1:27017/parksmart?replicaSet=rs0

# Database name (default: parksmart)
# MONGODB_DB=parksmart

# Port for the Express server (default: 4000)
# PORT=4000

# Set to "production" when serving the built client from Express.
# NODE_ENV=production
